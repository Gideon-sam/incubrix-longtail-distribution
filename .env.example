# =============================================================================
# IncuBrix Long-Tail Distribution — Environment Variables Example
# Copy to .env and fill in real values for production.
# Placeholders are marked with CHANGE_ME.
# =============================================================================

# -- Service --------------------------------------------------
SERVICE_NAME=incubrix-longtail
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# -- SIMULATION_MODE ------------------------------------------
# true  -> all connectors use mock data, no real API keys needed
# false -> uses real platform APIs (requires keys below)
SIMULATION_MODE=true

# -- Database -------------------------------------------------
POSTGRES_USER=incubrix
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=incubrix
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# -- Redis ----------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -- MinIO ----------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=incubrix
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=incubrix
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=incubrix-outputs
MINIO_SECURE=false

# -- AI Provider ----------------------------------------------
# mock   -> free, no API key, uses deterministic mock responses
# gemini -> requires GEMINI_API_KEY below
LLM_PROVIDER=mock
GEMINI_API_KEY=CHANGE_ME

# -- Rate limiting & access token -----------------------------
RATE_LIMIT=60/minute
ACCESS_TOKEN=CHANGE_ME
CALLBACK_SECRET=CHANGE_ME
AUTO_DISCLOSURE=false
ALLOWED_AUTOMATED_HOSTS=http://mock-discourse:4100,http://mock-discourse-2:4101,http://lemmy:8536,http://ghost:2368,https://dev.to,http://mock-devto:4150,http://mock-webhook:4200,http://mock-hashnode:4300,http://mock-peertube:4400
RECERT_INTERVAL_DAYS=25

# -- Connector Secrets ----------------------------------------
DEVTO_API_KEY=CHANGE_ME

GHOST_API_URL=http://ghost:2368
GHOST_ADMIN_API_KEY=CHANGE_ME

DISCOURSE_API_KEY=CHANGE_ME
DISCOURSE_API_URL=http://mock-discourse:4100

LEMMY_API_URL=http://lemmy:8536
LEMMY_USERNAME=incubrix_admin
LEMMY_PASSWORD=CHANGE_ME

HMAC_WEBHOOK_SECRET=CHANGE_ME
HMAC_WEBHOOK_URL=http://mock-webhook:4200/webhook

HASHNODE_API_KEY=CHANGE_ME
HASHNODE_API_URL=http://mock-hashnode:4300

PEERTUBE_API_URL=http://mock-peertube:4400
PEERTUBE_API_KEY=CHANGE_ME

# -- MRSS Output ----------------------------------------------
MRSS_OUTPUT_DIR=/app/outputs/mrss
