# =============================================================================
# IncuBrix Long-Tail Distribution — Environment Variables
# Copy to .env and fill in real values for production.
# All defaults work in SIMULATION_MODE with no real API keys.
# =============================================================================

# ── Service ──────────────────────────────────────────────────
SERVICE_NAME=incubrix-longtail
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── SIMULATION_MODE ──────────────────────────────────────────
# true  → all connectors use mock data, no real API keys needed
# false → uses real platform APIs (requires all keys below)
SIMULATION_MODE=true

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://incubrix:incubrix_pass@postgres:5432/incubrix

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=incubrix
MINIO_SECRET_KEY=incubrix_secret
MINIO_BUCKET=incubrix-outputs
MINIO_SECURE=false

# ── AI Provider ──────────────────────────────────────────────
# mock     → free, no API key, uses deterministic mock responses
# gemini   → requires GEMINI_API_KEY below
LLM_PROVIDER=mock
# GEMINI_API_KEY=AIza...

# ── Rate limiting & access token ─────────────────────────────
RATE_LIMIT=60/minute
# Uncomment to require this token on all /api/ routes (for public demo):
# ACCESS_TOKEN=your-secret-token-here

# ── Dev.to ───────────────────────────────────────────────────
# DEVTO_API_KEY=your-devto-api-key

# ── Ghost ────────────────────────────────────────────────────
GHOST_API_URL=http://ghost:2368
# GHOST_ADMIN_API_KEY=id:secret

# ── Discourse ────────────────────────────────────────────────
DISCOURSE_API_KEY=mock_discourse_key
DISCOURSE_API_URL=http://mock-discourse:4100
# For real Discourse: DISCOURSE_API_URL=https://your-forum.com

# ── Lemmy ────────────────────────────────────────────────────
LEMMY_API_URL=http://lemmy:8536
LEMMY_USERNAME=incubrix_admin
LEMMY_PASSWORD=incubrix_pass
# For real Lemmy: LEMMY_API_URL=https://lemmy.world

# ── HMAC Webhook ─────────────────────────────────────────────
HMAC_WEBHOOK_SECRET=webhook_secret_key
HMAC_WEBHOOK_URL=http://mock-webhook:4200/webhook

# ── Hashnode ─────────────────────────────────────────────────
HASHNODE_API_KEY=mock_hashnode_key
HASHNODE_API_URL=http://mock-hashnode:4300
# For real Hashnode: HASHNODE_API_URL=https://gql.hashnode.com

# ── PeerTube ─────────────────────────────────────────────────
PEERTUBE_API_URL=http://mock-peertube:4400
PEERTUBE_API_KEY=mock_peertube_key
# For real PeerTube: PEERTUBE_API_URL=https://your-peertube.instance

# ── MRSS Output ──────────────────────────────────────────────
MRSS_OUTPUT_DIR=/app/outputs/mrss
